# GRUPOS DE CREDENCIAIS DOS BANCOS DOS CLIENTES
# Varios clientes podem compartilhar o mesmo grupo.
DB_GRUPO_1_USER=postgres
DB_GRUPO_1_PASSWORD=
DB_GRUPO_2_USER=postgres
DB_GRUPO_2_PASSWORD=

# CREDENCIAIS SSH (apenas clientes que usam tunel)
SSH_GRUPO_1_USER=
SSH_GRUPO_1_PASSWORD=
SSH_GRUPO_1_PRIVATE_KEY=
SSH_GRUPO_2_USER=
SSH_GRUPO_2_PASSWORD=
SSH_GRUPO_2_PRIVATE_KEY=

# BANCO CENTRAL DO COLETOR
CENTRAL_DB_HOST=
CENTRAL_DB_PORT=5432
CENTRAL_DB_NAME=coletor_trafegus
CENTRAL_DB_USER=postgres
CENTRAL_DB_PASSWORD=
CENTRAL_DB_SSL=false

# BANCO CENTRAL DE ATENDIMENTOS (outro banco)
ATENDIMENTOS_DB_HOST=
ATENDIMENTOS_DB_PORT=5432
ATENDIMENTOS_DB_NAME=
ATENDIMENTOS_DB_USER=postgres
ATENDIMENTOS_DB_PASSWORD=
ATENDIMENTOS_DB_SSL=false

# BANCO DE APLICACAO (usuarios, sessoes, perfis, permissoes, clientes,
# grupos de credenciais e buscas salvas). Em teste, aponta para o
# Supabase; em producao, aponta para o PostgreSQL definitivo. O codigo
# da aplicacao nao muda entre os dois, so estes valores.
APP_DB_HOST=
APP_DB_PORT=5432
APP_DB_NAME=postgres
APP_DB_USER=postgres
APP_DB_PASSWORD=
APP_DB_SSL=true

# Chave (64 caracteres hex = 32 bytes) usada para criptografar senhas e
# chaves SSH dentro do banco. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA troque esta chave depois de ter dados salvos sem antes
# re-criptografar tudo, ou as senhas salvas ficam ilegiveis.
APP_ENCRYPTION_KEY=

# OPERACAO
TARGET_DATE=
CONCURRENCY=5
MAX_RETRIES=3
DB_CONNECTION_TIMEOUT=15000
DB_QUERY_TIMEOUT=60000
HTML_ONLY=true
WEB_PORT=3000
